{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure (clang debug)",
      "type": "shell",
      "command": "cmake --preset clang-debug",
      "problemMatcher": []
    },
    {
      "label": "build (clang debug)",
      "type": "shell",
      "command": "cmake --build --preset clang-debug",
      "dependsOn": "cmake configure (clang debug)",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
